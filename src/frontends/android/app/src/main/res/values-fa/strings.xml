    <string name="profile_proposals_label">الگوریتم‌ها</string>
    <string name="profile_proposals_intro">اختیاری: الگوریتم IKEv2 و IPsec/ESP به‌جای پیش‌فرض. موارد را با خط تیره جدا کنید.</string>
    <string name="profile_proposals_ike_label">الگوریتم‌های IKEv2</string>
    <string name="profile_proposals_ike_hint">برای رمز کلاسیک، الگوریتم یکپارچگی و گروه DH لازم است (مثل aes256-sha256-ecp256).</string>
    <string name="profile_proposals_esp_label">الگوریتم‌های IPsec/ESP</string>
    <string name="profile_proposals_esp_hint">برای رمز کلاسیک الگوریتم یکپارچگی لازم است. گروه DH اختیاری است.</string>
    <string name="profile_proxy_server_label">پروکسی HTTP</string>
