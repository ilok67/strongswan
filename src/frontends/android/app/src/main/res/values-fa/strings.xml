    <string name="profile_remote_id_label">هویت سرور</string>
    <string name="profile_remote_id_hint">پیش‌فرض برابر سرور است. مقدار سفارشی صریحاً به سرور فرستاده و هنگام احراز هویت اعمال می‌شود</string>
    <string name="profile_remote_id_hint_gateway">پیش‌فرض «%1$s». مقدار سفارشی صریحاً به سرور فرستاده و هنگام احراز هویت اعمال می‌شود</string>
    <string name="profile_local_id_label">هویت کلاینت</string>
    <string name="profile_local_id_hint_user">پیش‌فرض برابر نام کاربری است. در صورت نیاز سرور می‌توان مقدار دیگری گذاشت</string>
    <string name="profile_local_id_hint_cert">پیش‌فرض هویت گواهی است. مقدار سفارشی معمولاً باید با گواهی مطابقت داشته باشد</string>
    <string name="profile_dns_servers_label">سرورهای DNS</string>
    <string name="profile_dns_servers_hint">DNS سفارشی هنگام اتصال (با فاصله جدا شوند، مثل «8.8.8.8»). پیش‌فرض همان DNS دریافتی از سرور است</string>
    <string name="profile_mtu_label">MTU تونل</string>
    <string name="profile_mtu_hint">اگر مقدار پیش‌فرض برای شبکه مناسب نیست</string>
    <string name="profile_port_label">پورت سرور</string>
    <string name="profile_port_hint">پورت UDP اگر غیر از پیش‌فرض باشد</string>
    <string name="profile_nat_keepalive_label">بازه NAT-T keepalive</string>
    <string name="profile_nat_keepalive_hint">بسته‌های کوچک برای زنده نگه داشتن NAT. پیش‌فرض ۴۵ ثانیه است. اگر NAT زود قطع می‌کند ۲۰ ثانیه یا کمتر امتحان کنید.</string>
    <string name="profile_cert_req_label">ارسال درخواست گواهی</string>
    <string name="profile_cert_req_hint">درخواست گواهی برای CAهای موجود فرستاده می‌شود. برای کوچک‌تر شدن IKE_AUTH می‌توان خاموشش کرد.</string>
    <string name="profile_use_ocsp_label">بررسی گواهی با OCSP</string>
    <string name="profile_use_ocsp_hint">در صورت وجود، ابطال گواهی سرور با OCSP بررسی شود.</string>
    <string name="profile_use_crl_label">بررسی گواهی با CRL</string>
    <string name="profile_use_crl_hint">در صورت وجود، ابطال گواهی با CRL بررسی شود. فقط اگر OCSP نتیجه ندهد.</string>
    <string name="profile_strict_revocation_label">بررسی سخت‌گیرانه ابطال</string>
    <string name="profile_strict_revocation_hint">در حالت سخت، اگر وضعیت گواهی نامعلوم باشد هم احراز هویت شکست می‌خورد.</string>
    <string name="profile_rsa_pss_label">امضای RSA/PSS</string>
    <string name="profile_rsa_pss_hint">به‌جای PKCS#1 از PSS استفاده شود. اگر سرور پشتیبانی نکند اتصال قطع می‌شود.</string>
    <string name="profile_ipv6_transport_label">آدرس انتقال IPv6</string>
    <string name="profile_ipv6_transport_hint">در صورت وجود از IPv6 برای آدرس بیرونی استفاده شود. بسیاری از سرورها هنوز پشتیبانی نمی‌کنند.</string>
    <string name="profile_split_tunneling_label">Split tunneling</string>
    <string name="profile_split_tunneling_intro">به‌صورت پیش‌فرض همه ترافیک از وی‌پی‌ان می‌رود مگر سرور زیرشبکه‌ها را محدود کند.</string>
    <string name="profile_split_tunnelingv4_title">مسدود کردن ترافیک IPv4 خارج از وی‌پی‌ان</string>
    <string name="profile_split_tunnelingv6_title">مسدود کردن ترافیک IPv6 خارج از وی‌پی‌ان</string>
    <string name="profile_included_subnets_label">زیرشبکه‌های سفارشی</string>
    <string name="profile_included_subnets_hint">فقط این زیرشبکه‌ها از وی‌پی‌ان بروند (با فاصله، مثل «192.168.1.0/24»)</string>
    <string name="profile_excluded_subnets_label">زیرشبکه‌های مستثنی</string>
    <string name="profile_excluded_subnets_hint">این زیرشبکه‌ها از وی‌پی‌ان نروند (با فاصله جدا شوند)</string>
