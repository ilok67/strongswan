    <!-- Managed configuration, VPN profile, local -->
    <string name="managed_config_local_bundle_title">کلاینت</string>
    <string name="managed_config_local_bundle_description">اطلاعات مربوط به کلاینت را مشخص می‌کند</string>
    <string name="managed_config_local_eap_id_title">هویت/نام کاربری برای احراز هویت EAP (اختیاری)</string>
    <string name="managed_config_local_eap_id_description">اگر این مورد لازم باشد (برای احراز هویت EAP مبتنی بر نام کاربری/رمز) اما اینجا تنظیم نشده باشد، از کاربر پرسیده می‌شود. اگر تنظیم شود، کاربر نمی‌تواند آن را تغییر دهد. در هر دو حالت کاربر می‌تواند به‌صورت اختیاری رمز عبور را وارد کند</string>
    <string name="managed_config_local_eap_password_title">رمز عبور برای احراز هویت EAP (اختیاری)</string>
    <string name="managed_config_local_eap_password_description">اگر این مورد لازم باشد (برای احراز هویت EAP مبتنی بر نام کاربری/رمز) اما اینجا تنظیم نشده باشد، از کاربر پرسیده می‌شود و می‌تواند آن را به‌صورت محلی ذخیره کند</string>
    <string name="managed_config_local_id_title">@string/profile_local_id_label</string>
    <string name="managed_config_local_id_description">@string/profile_local_id_hint_user</string>
    <string name="managed_config_local_p12_title">@string/profile_user_certificate_label</string>
    <string name="managed_config_local_p12_description">محفظه PKCS#12 به‌صورت Base64 همراه با گواهی کلاینت و کلید خصوصی و زنجیره گواهی اختیاری (مورد آخر ممکن است در نسخه‌های قدیمی‌تر اندروید هشدار ایجاد کند، برای جزئیات به پیکربندی کلاینت وی‌پی‌ان اندروید مراجعه کنید). برای احراز هویت EAP مبتنی بر نام کاربری/رمز یا اگر کاربر از قبل گواهی/کلید را نصب کرده باشد لازم نیست، چون ممکن است هنگام ورود پروفایل انتخاب شود</string>
    <string name="managed_config_local_p12_password_title">رمز عبور گواهی کاربر (اختیاری)</string>
    <string name="managed_config_local_p12_password_description">رمز عبور موردنیاز برای استخراج کلید خصوصی محفظه PKCS#12 جهت نصب</string>
    <string name="managed_config_local_user_certificate_alias_title">نام مستعار گواهی کاربر (اختیاری)</string>
    <string name="managed_config_local_user_certificate_alias_description">نام مستعار یک گواهی/کلید کاربر که از قبل روی دستگاه نصب شده است. برنامه باید توسط MDM به آن دسترسی داشته باشد. فقط زمانی استفاده می‌شود که گواهی همراه پیکربندی توزیع نشده باشد. اگر گواهی لازم باشد و این تنظیم نشده باشد، کاربر می‌تواند به‌صورت دستی یک گواهی محلی انتخاب کند</string>
    <string name="managed_config_local_rsa_pss_title">@string/profile_rsa_pss_label</string>
    <string name="managed_config_local_rsa_pss_description">@string/profile_rsa_pss_hint</string>

