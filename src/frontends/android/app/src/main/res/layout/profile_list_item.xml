<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/profile_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/profile_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profile_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            tools:text="🇫🇷 1.2.3.4:1234" />

        <ImageButton
            android:id="@+id/profile_item_share"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/action_share"
            android:focusable="false"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_share"
            app:tint="#94A3B8" />

        <ImageButton
            android:id="@+id/profile_item_edit"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/action_edit"
            android:focusable="false"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            app:tint="#94A3B8" />

        <ImageButton
            android:id="@+id/profile_item_delete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/icon_btn_bg"
            android:contentDescription="@string/action_delete"
            android:focusable="false"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_delete"
            app:tint="#F87171" />
    </LinearLayout>

    <TextView
        android:id="@+id/profile_item_managed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_managed"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:visibility="gone" />

    <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/profile_item_gateway"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:textColorSecondary" />

    <TextView
        android:id="@+id/profile_item_ping"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:textColorSecondary"
        android:text="—" />
</LinearLayout>

    <TextView
        android:id="@+id/profile_item_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <TextView
        android:id="@+id/profile_item_certificate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
